# Apenas desenvolvimento local, com banco novo e sem envio de e-mails.
# Gere .env com: python scripts/create_local_env.py
# O Django não lê este arquivo automaticamente; exporte as variáveis no terminal.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=GERAR_CHAVE_DJANGO
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_SITE_URL=https://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DATABASE_URL=
DATABASE_ENGINE=sqlite
SQLITE_NAME=demo.sqlite3
FIELD_ENCRYPTION_ACTIVE_KEY=v1
FIELD_ENCRYPTION_KEYS=v1:GERAR_CHAVE_CRIPTOGRAFIA
FIELD_HASH_KEY=GERAR_CHAVE_HASH
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_DELIVERY_ENABLED=False
MEDIA_STORAGE_ENDPOINT=
CORS_ALLOWED_ORIGINS=

# Opcionais: para testar PostgreSQL, altere DATABASE_ENGINE para postgresql.
POSTGRES_DB=globo_vidracaria
POSTGRES_USER=globo_vidracaria
POSTGRES_PASSWORD=GERAR_SENHA_POSTGRES
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
